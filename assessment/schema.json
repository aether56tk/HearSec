{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HearSec Hearing Technology Assessment",
  "type": "object",
  "required": [
    "assessment_id",
    "target",
    "date",
    "findings"
  ],
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "authorization": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "authorized_by": {
          "type": "string"
        },
        "testing_window": {
          "type": "string"
        },
        "data_handling": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "device_type"
      ],
      "properties": {
        "device_type": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "serial_number": {
          "type": "string"
        },
        "firmware": {
          "type": "string"
        },
        "companion_app": {
          "type": "string"
        },
        "app_version": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "clinical_software": {
          "type": "string"
        },
        "connectivity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "security_domains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "data_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "destination"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "data_category": {
            "type": "string"
          },
          "protection": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "reproducible": {
            "type": "boolean"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "title",
          "evidence",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "type": "object",
            "required": [
              "likelihood",
              "impact"
            ],
            "properties": {
              "likelihood": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "impact": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "level": {
                "type": "string"
              }
            }
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "assessment_notes": {
      "type": "object",
      "properties": {
        "known": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ai_assessments": {
      "type": "array",
      "description": "Evidence-grounded AI assessment records. AI output requires human verification before becoming a final finding.",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "evidence_text",
          "evidence_status",
          "ai_interpretation",
          "proposed_status",
          "source_refs",
          "human_verification"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "evidence_text": {
            "type": "string"
          },
          "evidence_status": {
            "type": "string"
          },
          "ai_interpretation": {
            "type": "string"
          },
          "proposed_status": {
            "type": "string",
            "enum": [
              "confirmed_observation",
              "supported_finding",
              "insufficient_evidence",
              "not_assessed",
              "not_applicable"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "human_verification": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "verified",
                  "rejected",
                  "corrected"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "decision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "metrics": {
            "type": "object"
          }
        }
      }
    },
    "framework_version": {
      "type": "string"
    },
    "evidence_summary": {
      "type": "object"
    },
    "clinical_translations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
