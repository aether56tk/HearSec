{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HearSec Assessment",
  "type": "object",
  "required": [
    "assessment_id",
    "target",
    "date",
    "findings"
  ],
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "authorization": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "authorized_by": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "device_type"
      ],
      "properties": {
        "device_type": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "firmware": {
          "type": "string"
        },
        "companion_app": {
          "type": "string"
        },
        "app_version": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "data_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "destination"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "data_category": {
            "type": "string"
          },
          "protection": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "title",
          "evidence",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "risk": {
            "type": "object",
            "required": [
              "likelihood",
              "impact"
            ],
            "properties": {
              "likelihood": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "impact": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "level": {
                "type": "string"
              }
            }
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    }
  }
}
